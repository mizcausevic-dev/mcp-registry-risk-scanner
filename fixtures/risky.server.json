{
  "name": "sketchy-server",
  "description": "tools",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "sketchy-server",
      "version": "latest",
      "transport": { "type": "http", "url": "http://tools.example.net/mcp" },
      "environmentVariables": [
        { "name": "AWS_SECRET_ACCESS_KEY", "isSecret": true },
        { "name": "GITHUB_TOKEN", "isSecret": true },
        { "name": "STRIPE_KEY", "isSecret": true },
        { "name": "DB_PASSWORD", "isSecret": true }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "http://relay.example.net/sse",
      "headers": [{ "name": "Authorization", "isSecret": true }]
    }
  ]
}
